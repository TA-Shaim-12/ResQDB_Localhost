# Copy this file to .env and fill in your actual values.
# Locally, leave the DB_* block as-is if you run MySQL on your own machine.
# On Railway, you generally don't need DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME
# at all — Railway's MySQL plugin injects MYSQL_URL automatically and db.js
# will use it. Only set DB_* if you want to override that.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=resqdb
# Set to "true" only if your hosted MySQL provider requires TLS.
DB_SSL=false

PORT=4000

# Comma-separated list of frontend origins allowed to call this API.
# Example: https://resqdb.netlify.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Authentication ---
# Long random string — generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

ADMIN_USERNAME=admin
# Easiest for a demo: set a plain password here.
ADMIN_PASSWORD=
# More secure alternative: set a bcrypt hash instead of ADMIN_PASSWORD, using
# backend/scripts/hash-password.js to generate it. If both are set,
# ADMIN_PASSWORD_HASH wins.
ADMIN_PASSWORD_HASH=
